{
  "rules": {
    ".read": false,
    ".write": false,

    "leaderboard": {
      ".read": true,
      ".write": true
    },

    "codes": {
      "$code": {
        ".read": true,
        ".write": "(!data.exists() && newData.exists() && $code.matches(/^[0-9]{8}$/) && newData.child('valid').val() === true) || auth.uid === 'b8KLqkxnrmPlnHuiRWewJKWSlek1'",
        ".validate": "newData.hasChildren(['username','app','valid','at']) && newData.child('app').val().matches(/^(twibbon|letter|photobooth)$/)"
      }
    },

    "missions": {
      "$username": {
        "$app": {
          ".read": "auth.uid === 'b8KLqkxnrmPlnHuiRWewJKWSlek1'",
          ".write": "(!data.exists() && newData.exists()) || auth.uid === 'b8KLqkxnrmPlnHuiRWewJKWSlek1'"
        }
      }
    }
  }
}
